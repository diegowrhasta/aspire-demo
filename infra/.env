# Container image name for apiservice
APISERVICE_IMAGE=aspireapp1.apiservice

# Default container port for apiservice
APISERVICE_PORT=8080

# Parameter password
RABBIT_PASSWORD=12345678

# Container image name for rabbitConsumer
RABBITCONSUMER_IMAGE=aspireapp1.rabbitconsumer

# Default container port for rabbitConsumer
RABBITCONSUMER_PORT=8080

# Container image name for sql-probe
SQL_PROBE_IMAGE=mssqlprobe.apiservice

# Default container port for sql-probe
SQL_PROBE_PORT=8080

# Parameter username
RABBIT_USERNAME=admin

# Container image name for webfrontend
WEBFRONTEND_IMAGE=aspireapp1.web

# Default container port for webfrontend
WEBFRONTEND_PORT=8080
